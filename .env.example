# Auth0 → Applications → (tu app SPA) y APIs
VITE_AUTH0_DOMAIN=tu-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://vitania-api

# Neon → Dashboard → Connection string
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.neon.tech/neondb?sslmode=require

# Avisos push: genera las claves con  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com

# Secreto para el cron externo que llama a /api/cron/tick (cualquier texto largo y aleatorio)
CRON_SECRET=
